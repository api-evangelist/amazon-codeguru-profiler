{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon CodeGuru Profiler Internal Tags API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Amazon CodeGuru Profiler List Tags for Resource",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://codeguru-profiler.{region}.amazonaws.com/tags/:resourceArn",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "resourceArn",
                "value": "",
                "type": "path",
                "description": " The Amazon Resource Name (ARN) of the resource that contains the tags to return. "
              }
            ]
          },
          "docs": " Returns a list of the tags that are assigned to a specified resource. "
        },
        {
          "info": {
            "name": "Amazon CodeGuru Profiler Tag Resource",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://codeguru-profiler.{region}.amazonaws.com/tags/:resourceArn",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "resourceArn",
                "value": "",
                "type": "path",
                "description": " The Amazon Resource Name (ARN) of the resource that the tags are added to. "
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": " Use to assign one or more tags to a resource. "
        },
        {
          "info": {
            "name": "Amazon CodeGuru Profiler Untag Resource",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://codeguru-profiler.{region}.amazonaws.com/tags/:resourceArn#tagKeys",
            "headers": [
              {
                "name": "X-Amz-Content-Sha256",
                "value": ""
              },
              {
                "name": "X-Amz-Date",
                "value": ""
              },
              {
                "name": "X-Amz-Algorithm",
                "value": ""
              },
              {
                "name": "X-Amz-Credential",
                "value": ""
              },
              {
                "name": "X-Amz-Security-Token",
                "value": ""
              },
              {
                "name": "X-Amz-Signature",
                "value": ""
              },
              {
                "name": "X-Amz-SignedHeaders",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "resourceArn",
                "value": "",
                "type": "path",
                "description": " The Amazon Resource Name (ARN) of the resource that contains the tags to remove. "
              },
              {
                "name": "tagKeys",
                "value": "",
                "type": "query",
                "description": " A list of tag keys. Existing tags of resources with keys in this list are removed from the specified resource. "
              }
            ]
          },
          "docs": " Use to remove one or more tags from a resource. "
        }
      ]
    }
  ],
  "bundled": true
}